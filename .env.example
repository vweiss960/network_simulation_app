# Copy to .env (gitignored). Read by docker compose and by the native systemd
# unit (scripts/install-host.sh points EnvironmentFile at it).

# --- Auth -------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET_KEY=generate-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- Paths (defaults: inside the repo checkout) ------------------------------
# DEVICE_IMAGES_DIR=/srv/plabs/images    # vendor tarballs / qcow2 + vrnetlab clone
# LAB_STATE_DIR=/srv/plabs/lab_state

# --- Lab management network --------------------------------------------------
# Configured in the UI (Network page). This only sets the subnet of the
# *internal* mode Docker network (default 172.30.0.0/22).
# PLABS_LAB_MGMT_SUBNET=10.77.77.0/24

# --- AI lab agent -----------------------------------------------------------
# Claude (default: Claude Opus 5.5) and/or OpenAI models; the chat panel offers
# every model whose provider has a key.
PLABS_AI_ENABLED=0
PLABS_AI_API_KEY=                    # Anthropic key (falls back to ANTHROPIC_API_KEY)
# PLABS_AI_MODEL=claude-opus-5-5     # default model
# PLABS_AI_CLAUDE_MODELS=claude-opus-5-5,claude-sonnet-5-5
# PLABS_AI_OPENAI_API_KEY=           # OpenAI key (falls back to OPENAI_API_KEY)
# PLABS_AI_OPENAI_MODELS=            # comma list of OpenAI model ids to offer
# PLABS_AI_OPENAI_BASE_URL=          # optional OpenAI-compatible endpoint (e.g. a LiteLLM proxy)

# --- Learning add-on: lessons, modules (curricula later) -----------------------
# Graded lessons on lab topologies, grouped into modules. Off: the Learning
# menu is hidden, its API answers 404, and lesson labs act as ordinary labs
# (nothing is deleted). Recreate the backend after changing it.
PLABS_LEARNING_ENABLED=0
# PLABS_CURRICULUM_DIR=./curriculum  # bundled lesson / module packs, imported at startup

# --- Optional lab telemetry (gnmic sidecar → Prometheus on :9274) ------------
PLABS_LAB_TELEMETRY_ENABLED=0
