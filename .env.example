# ---------------------------------------------------------------------------
# AI assistant provider (used when PHANERO_AI_ENABLED / Config Design / Service
# AI are on). Recreate the backend after changing: docker compose up -d backend
# ---------------------------------------------------------------------------
# anthropic (default) | openai | litellm
#   litellm = a LiteLLM proxy (OpenAI-compatible) that routes to any backend
#   model it's configured for; PHANERO_AI_MODEL is then a proxy model alias.
PHANERO_AI_PROVIDER=anthropic
# Provider API key. For anthropic, ANTHROPIC_API_KEY below also works.
# For a LiteLLM proxy this is the proxy's master/virtual key (blank if none).
PHANERO_AI_API_KEY=
# API base URL — required for litellm (e.g. http://localhost:4000; the backend
# runs in host network mode). Optional override for anthropic / openai.
PHANERO_AI_BASE_URL=
# Main model. Defaults to claude-sonnet-4-6 on anthropic; required otherwise.
PHANERO_AI_MODEL=
# Optional fast model for the main chat's tool-selection turns (the main model
# then writes the final analysis). Defaults to claude-haiku-4-5 on anthropic,
# otherwise to PHANERO_AI_MODEL.
PHANERO_AI_TOOL_MODEL=

# Legacy Anthropic key (used when PHANERO_AI_PROVIDER=anthropic and
# PHANERO_AI_API_KEY is empty). Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Lab Mode (containerlab integration) — set to 1 to enable. Off by default
# because the feature requires a privileged backend container and is still
# pre-production. When enabled, the "Lab" toggle appears in the top-right of
# the topology view; when disabled, the lab API routes aren't even registered.
PHANERO_LAB_ENABLED=0

# Lab telemetry add-on: gNMI telemetry collection (gnmic -> Prometheus) plus
# one-shot gNMI path testing for lab nodes. Only takes effect
# when PHANERO_LAB_ENABLED=1 too. Off by default (not part of the standard suite).
PHANERO_LAB_TELEMETRY_ENABLED=0

# Service module: render config from caller-supplied JSON and push it (SSH) to
# lab nodes or topology mgmt IPs. Only takes effect when PHANERO_LAB_ENABLED=1
# too. Off by default (not part of the standard suite).
PHANERO_SERVICE_ENABLED=0

# Optional: override containerlab's default management subnet (172.20.20.0/24).
# Set this if that range overlaps another Docker network on your host (lab
# deploy fails with "Pool overlaps with other one on this address space").
# Pick any free RFC1918 range, e.g. 10.77.77.0/24. Leave blank for the default.
PHANERO_LAB_MGMT_SUBNET=
PHANERO_LAB_MGMT_SUBNET6=

# Config Design (Jinja templates + per-platform defaults + rendered configs)
# — set to 1 to enable. Off by default while the feature is still in dev.
PHANERO_CONFIG_DESIGN_ENABLED=0

# Optional feature modules — each OFF by default. When off, the module's API
# routes aren't registered (its endpoints 404) and the frontend hides its menu.
# Set to 1 to enable. The Device Templates menu is gated by PHANERO_LAB_ENABLED.
PHANERO_GEO_ENABLED=0          # Geographic map view (globe + overlays + KMZ)
PHANERO_AI_ENABLED=0           # AI assistant chat
PHANERO_DISCOVERY_ENABLED=0    # Network discovery
PHANERO_PROMETHEUS_ENABLED=0   # Prometheus live metrics
PHANERO_COST_ENABLED=0         # Cost allocation
PHANERO_INTEGRATIONS_ENABLED=0 # External integrations
PHANERO_PATCH_PANELS_ENABLED=0 # Patch panel documentation (right-click a device)

# ---------------------------------------------------------------------------
# Geographic map view (Protomaps / MapLibre)
# ---------------------------------------------------------------------------
# The map needs a Protomaps basemap. Pick ONE of the three options below.
# Changing any of these only requires `docker compose up -d backend`
# (the values are served to the frontend at runtime via /api/features —
# no frontend rebuild needed). Theme applies to the cloud + self-hosted
# .pmtiles paths: light | dark | white | black | grayscale.
PROTOMAPS_THEME=black

# Option A — Protomaps hosted cloud (easiest). Get a free key at
#   https://protomaps.com/account
# and uncomment:
# PROTOMAPS_API_KEY=your_protomaps_key_here

# Option B — Self-hosted PMTiles. Serve a .pmtiles extract (e.g. via
# `pmtiles serve`, Caddy/nginx with range requests, or the go-pmtiles
# server) with CORS enabled, then point at the file. The app builds the
# Protomaps style (PROTOMAPS_THEME flavor) around this source:
# PROTOMAPS_TILES_URL=https://maps.your-domain.com/basemap.pmtiles

# Option C — A full MapLibre style JSON you host yourself (overrides theme;
# you control sources/glyphs/sprites in the style). Highest control:
# PROTOMAPS_STYLE_URL=https://maps.your-domain.com/style.json

# Precedence if more than one is set: STYLE_URL > API_KEY > TILES_URL.
# With none set, the Geographic view shows a "not configured" message.

# Data-center overlay (PeeringDB). Optional — anonymous reads work and are
# cached 24h, but are rate-limited; a key raises the limit. Get one at
# peeringdb.com (Profile → API Keys).
# PEERINGDB_API_KEY=your_peeringdb_key_here
