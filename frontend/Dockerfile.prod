# Production frontend: build the static bundle, serve it with nginx.
# Dev still uses ./Dockerfile (the Vite dev server) — this file is only used by
# docker-compose.prod.yml. Fixes slow remote page loads: the browser fetches a
# few hashed, minified files instead of thousands of unbundled dev modules.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
# Build with vite directly rather than `npm run build` (which is `tsc && vite
# build`): the project has pre-existing type errors that don't affect the
# emitted bundle, and esbuild transpiles without typechecking. The bundle is
# identical to what the dev server serves, just pre-built and minified.
RUN npx vite build

# --- serve ---
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 5173
# nginx:alpine's base image runs nginx in the foreground by default.
